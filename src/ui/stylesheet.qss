/* Syncacademic Portal — Light Theme v3
 * =========================================================== */

/* ── BASE ─────────────────────────────────────────────────── */
QMainWindow, QDialog, QWidget {
    background-color: @COLOR_BACKGROUND@;
    color: #0F172A;
    font-family: 'Inter', 'Segoe UI', 'SF Pro Text', Arial, sans-serif;
    font-size: 12px;
}

/* ── APP HEADER ───────────────────────────────────────────── */
QWidget#appHeader {
    background-color: @COLOR_SIDEBAR@;
    border-bottom: 1px solid #E2E8F0;
}

/* ── SIDEBAR ──────────────────────────────────────────────── */
QWidget#sidebar {
    background-color: @COLOR_SIDEBAR@;
    border-right: 1px solid #E2E8F0;
}

/* ── CARDS & GROUP BOXES ──────────────────────────────────── */
QGroupBox {
    background-color: @COLOR_CARD_BG@;
    border: 1px solid #E2E8F0;
    border-left: 3px solid @COLOR_PRIMARY@;
    border-radius: 8px;
    margin-top: 14px;
    padding-top: 16px;
    padding-bottom: 8px;
    padding-left: 4px;
    padding-right: 4px;
}

QGroupBox::title {
    color: @COLOR_PRIMARY@;
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    top: -2px;
    padding: 0 6px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.8px;
}

/* ── PROGRESS BAR (generation indicator) ─────────────────── */
QProgressBar {
    border: none;
    border-radius: 2px;
    background-color: #E2E8F0;
    max-height: 4px;
    min-height: 4px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: @COLOR_PRIMARY@;
    border-radius: 2px;
}

/* ── TABLE ────────────────────────────────────────────────── */
QTableWidget {
    background-color: @COLOR_CARD_BG@;
    alternate-background-color: #F8FAFC;
    gridline-color: #E2E8F0;
    selection-background-color: @COLOR_HOVER@;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    color: #0F172A;
}

QTableWidget::item {
    padding: 6px 8px;
    border: none;
    color: #0F172A;
}

QTableWidget::item:hover {
    background-color: #F8FAFC;
}

QTableWidget::item:selected {
    background-color: @COLOR_HOVER@;
    color: @COLOR_PRIMARY@;
}

QHeaderView {
    background-color: #F8FAFC;
}

QHeaderView::section {
    background-color: #F8FAFC;
    color: #64748B;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.5px;
    border: none;
    border-bottom: 2px solid #E2E8F0;
    padding: 10px 8px;
    min-height: 34px;
}

QHeaderView::section:hover {
    background-color: @COLOR_HOVER@;
    color: @COLOR_PRIMARY@;
}

QDateEdit, QCalendarWidget, QMessageBox {
    background-color: @COLOR_CARD_BG@;
    border: 1px solid #D1D5DB;
    border-radius: 6px;
    color: #374151;
}

/* ── BUTTONS ──────────────────────────────────────────────── */
QPushButton {
    background-color: @COLOR_CARD_BG@;
    color: #374151;
    border: 1px solid #D1D5DB;
    border-radius: 6px;
    padding: 6px 14px;
    font-size: 11px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: @COLOR_HOVER@;
    border-color: @COLOR_PRIMARY@;
    color: @COLOR_PRIMARY@;
}

QPushButton:pressed {
    background-color: #DBEAFE;
    border-color: @COLOR_SECONDARY@;
    color: @COLOR_SECONDARY@;
}

QPushButton:focus {
    border-color: @COLOR_PRIMARY@;
    outline: none;
}

QPushButton:disabled {
    color: #CBD5E1;
    background-color: #F8FAFC;
    border: 1px solid #E5E7EB;
}

/* Generate CTA — solid blue pill */
QPushButton#generateBtn {
    background-color: @COLOR_PRIMARY@;
    border: none;
    border-radius: 10px;
    color: #FFFFFF;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.3px;
    padding: 10px 0;
}

QPushButton#generateBtn:hover {
    background-color: @COLOR_SECONDARY@;
}

QPushButton#generateBtn:pressed {
    background-color: #1E40AF;
}

QPushButton#generateBtn:disabled {
    background-color: #BFDBFE;
    color: #93C5FD;
    border: none;
}

/* ── TABS ─────────────────────────────────────────────────── */
QTabWidget::pane {
    border: 1px solid #E2E8F0;
    border-top: none;
    border-radius: 0 0 8px 8px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #EBF4FF, stop:0.45 #F5F0FF, stop:1 #EBF4FF);
}

QTabBar::tab {
    background: transparent;
    color: #94A3B8;
    padding: 10px 22px;
    border: none;
    border-bottom: 2px solid transparent;
    margin-right: 4px;
    font-size: 12px;
    font-weight: 500;
}

QTabBar::tab:selected {
    background: transparent;
    color: @COLOR_PRIMARY@;
    border-bottom: 2px solid @COLOR_PRIMARY@;
    font-weight: 700;
}

QTabBar::tab:hover:!selected {
    color: #475569;
    border-bottom: 2px solid #CBD5E1;
    background: #F8FAFC;
}

/* ── LIST WIDGET ──────────────────────────────────────────── */
QListWidget {
    background-color: @COLOR_CARD_BG@;
    border: 1px solid #E2E8F0;
    border-radius: 6px;
    outline: none;
    color: #374151;
}

QListWidget::item {
    padding: 6px 10px;
    border-radius: 4px;
    margin: 1px 3px;
    color: #374151;
}

QListWidget::item:hover {
    background-color: #F1F5F9;
}

QListWidget::item:selected {
    background-color: @COLOR_HOVER@;
    color: @COLOR_PRIMARY@;
}

/* ── RADIO BUTTONS ────────────────────────────────────────── */
QRadioButton {
    color: #1F2937;
    font-size: 13px;
    font-weight: 500;
    spacing: 8px;
}

QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border-radius: 8px;
    border: 2px solid #CBD5E1;
    background: #FFFFFF;
}

QRadioButton::indicator:hover {
    border-color: @COLOR_PRIMARY@;
}

/* Wide border + white fill creates the inner dot look — no image required */
QRadioButton::indicator:checked {
    border: 5px solid @COLOR_PRIMARY@;
    background: #FFFFFF;
    border-radius: 8px;
}

/* ── SCROLLBARS ───────────────────────────────────────────── */
QScrollBar:vertical {
    width: 7px;
    background: transparent;
    border-radius: 3px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #CBD5E1;
    min-height: 24px;
    border-radius: 3px;
}

QScrollBar::handle:vertical:hover {
    background: #94A3B8;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }

QScrollBar:horizontal {
    height: 7px;
    background: transparent;
    border-radius: 3px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: #CBD5E1;
    min-width: 24px;
    border-radius: 3px;
}

QScrollBar::handle:horizontal:hover {
    background: #94A3B8;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

/* ── CALENDAR POPUP (QDateEdit dropdown) ─────────────────── */
QCalendarWidget {
    background-color: #FFFFFF;
}

QCalendarWidget QAbstractItemView {
    background-color: #FFFFFF;
    color: #0F172A;
    selection-background-color: #2563EB;
    selection-color: #FFFFFF;
    outline: none;
    gridline-color: #E2E8F0;
}

QCalendarWidget QAbstractItemView:enabled {
    color: #0F172A;
    background-color: #FFFFFF;
}

QCalendarWidget QAbstractItemView:disabled {
    color: #CBD5E1;
}

QCalendarWidget QWidget#qt_calendar_navigationbar {
    background-color: #F8FAFC;
    border-bottom: 1px solid #E2E8F0;
    padding: 4px 8px;
    min-height: 36px;
}

QCalendarWidget QToolButton {
    color: #374151;
    background-color: transparent;
    border: none;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 12px;
    font-weight: 600;
    min-width: 24px;
}

QCalendarWidget QToolButton:hover {
    background-color: #EFF6FF;
    color: #2563EB;
}

QCalendarWidget QToolButton:pressed {
    background-color: #DBEAFE;
    color: #1D4ED8;
}

QCalendarWidget QSpinBox {
    color: #374151;
    background-color: #FFFFFF;
    border: 1px solid #D1D5DB;
    border-radius: 4px;
    padding: 2px 6px;
    selection-background-color: #2563EB;
    selection-color: #FFFFFF;
}

QCalendarWidget QMenu {
    background-color: #FFFFFF;
    color: #0F172A;
    border: 1px solid #E2E8F0;
    border-radius: 6px;
}

QCalendarWidget QMenu::item:selected {
    background-color: #EFF6FF;
    color: #2563EB;
}

/* ── SPLITTER ─────────────────────────────────────────────── */
QSplitter {
    background: transparent;
}

QSplitter::handle {
    background: #E2E8F0;
}

QSplitter::handle:hover {
    background: @COLOR_PRIMARY@;
}

/* ── MISC ─────────────────────────────────────────────────── */
QLabel, QScrollArea, QScrollArea > QWidget > QWidget {
    background: transparent;
}

QScrollBar {
    background: transparent;
}
