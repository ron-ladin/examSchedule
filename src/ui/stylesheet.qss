/* ==========================================================================
   SYNCADEMIC APPLICATION STYLE (QSS)
   ========================================================================== */

/* ──────────────────────────────────────────────────────────────────────────
   GROUP 1: THE CORE APP BACKGROUND
   ────────────────────────────────────────────────────────────────────────── */
QMainWindow, QDialog, QWidget, QTabWidget::pane {
    background-color: @COLOR_BACKGROUND@;
    color: @COLOR_PRIMARY@;
    font-family: 'Segoe UI', Arial, sans-serif;
    font-size: 12px;
}

/* ──────────────────────────────────────────────────────────────────────────
   GROUP 2: DEEP SIDEBAR & VIEWPORTS
   ────────────────────────────────────────────────────────────────────────── */
QWidget#sidebar, QListWidget, QTableWidget, QScrollBar, QTabBar::tab {
    background-color: @COLOR_SIDEBAR@;
}

/* ──────────────────────────────────────────────────────────────────────────
   GROUP 3: CARDS, CONTAINERS & PAPERS
   ────────────────────────────────────────────────────────────────────────── */
QGroupBox, QPushButton,
QHeaderView, QHeaderView::section, QDateEdit, QCalendarWidget, QMessageBox {
    background-color: @COLOR_CARD_BG@;
}

/* alternate-background-color is a property on the widget, not a subcontrol selector */
QTableWidget {
    alternate-background-color: @COLOR_CARD_BG@;
}

/* ──────────────────────────────────────────────────────────────────────────
   GROUP 4: INTERACTION STATES (HOVER & SELECTION)
   ────────────────────────────────────────────────────────────────────────── */
QPushButton:hover, QPushButton#generateBtn, QListWidget::item:hover,
QTableWidget::item:selected, QHeaderView::section:hover, QTabBar::tab:hover:!selected {
    background-color: @COLOR_HOVER@;
}

QListWidget::item:selected, QTableWidget::item:selected, QTabBar::tab:selected {
    color: @COLOR_SECONDARY@;
}

/* ──────────────────────────────────────────────────────────────────────────
   GROUP 5: BUTTON STATES
   ────────────────────────────────────────────────────────────────────────── */
QPushButton:pressed {
    background-color: @COLOR_SIDEBAR@;
}

QPushButton:disabled {
    color: rgba(173, 198, 255, 0.35);
    background-color: @COLOR_CARD_BG@;
    border: 1px solid rgba(255, 255, 255, 0.05);
}

/* ──────────────────────────────────────────────────────────────────────────
   GROUP 6: SCROLLBAR
   ────────────────────────────────────────────────────────────────────────── */
QScrollBar:vertical {
    width: 8px;
    background: @COLOR_SIDEBAR@;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background: @COLOR_HOVER@;
    min-height: 24px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: @COLOR_PRIMARY@;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
    background: none;
}

QScrollBar:horizontal {
    height: 8px;
    background: @COLOR_SIDEBAR@;
    border-radius: 4px;
}

QScrollBar::handle:horizontal {
    background: @COLOR_HOVER@;
    min-width: 24px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal:hover {
    background: @COLOR_PRIMARY@;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
    background: none;
}

/* ──────────────────────────────────────────────────────────────────────────
   GROUP 7: RADIO BUTTONS & CHECKBOXES
   ────────────────────────────────────────────────────────────────────────── */
QRadioButton::indicator {
    width: 14px;
    height: 14px;
    border-radius: 7px;
    border: 1px solid rgba(255, 255, 255, 0.25);
    background: @COLOR_SIDEBAR@;
}

QRadioButton::indicator:checked {
    background: @COLOR_SECONDARY@;
    border-color: @COLOR_SECONDARY@;
}

/* ──────────────────────────────────────────────────────────────────────────
   GROUP 8: GROUP BOX TITLE
   ────────────────────────────────────────────────────────────────────────── */
QGroupBox::title {
    color: @COLOR_SECONDARY@;
    subcontrol-origin: margin;
    left: 8px;
    padding: 0 4px;
}

/* ──────────────────────────────────────────────────────────────────────────
   GROUP 9: TAB WIDGET PANE BORDER
   ────────────────────────────────────────────────────────────────────────── */
QTabWidget::pane {
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 4px;
}

/* ──────────────────────────────────────────────────────────────────────────
   GROUP 10: TABLE HEADER SEPARATOR
   ────────────────────────────────────────────────────────────────────────── */
QHeaderView::section {
    border-bottom: 1px solid rgba(255, 255, 255, 0.15);
    padding: 4px 8px;
}

/* ──────────────────────────────────────────────────────────────────────────
   GROUP 11: SPLITTER HANDLE
   ────────────────────────────────────────────────────────────────────────── */
QSplitter::handle {
    background: rgba(255, 255, 255, 0.07);
}

QSplitter::handle:hover {
    background: @COLOR_HOVER@;
}

/* ──────────────────────────────────────────────────────────────────────────
   GROUP 12: SPECIAL COMPONENT TWEAKS
   ────────────────────────────────────────────────────────────────────────── */
QWidget#sidebar { border-right: 1px solid rgba(255, 255, 255, 0.1); }

QPushButton#generateBtn {
    border: 1px solid @COLOR_PRIMARY@;
    font-size: 13px;
    font-weight: bold;
}

QLabel, QScrollArea, QScrollArea > QWidget > QWidget { background: transparent; }

QGroupBox, QListWidget, QDateEdit { border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 4px; }
