/* Syncacademic Portal — Light Theme v4 (SaaS Design System)
 * =========================================================== */

/* ── BASE ─────────────────────────────────────────────────── */
QMainWindow, QDialog, QWidget {
    background-color: @COLOR_BACKGROUND@;
    color: #1a1c1e;
    font-family: 'Inter', 'Segoe UI', 'SF Pro Text', Arial, sans-serif;
    font-size: 12px;
}

/* ── TOOLTIPS ─────────────────────────────────────────────── */
/* A global stylesheet makes Qt paint tooltips as a black box unless we
 * style QToolTip ourselves, so give it readable colors (SCRUM-399). */
QToolTip {
    background-color: #1a1c1e;
    color: #ffffff;
    border: 1px solid rgba(194, 198, 214, 0.6);
    border-radius: 6px;
    padding: 4px 8px;
    font-size: 12px;
}

/* ── APP HEADER ───────────────────────────────────────────── */
QWidget#appHeader {
    background-color: @COLOR_SIDEBAR@;
    border-bottom: 1px solid rgba(194, 198, 214, 0.6);
}

/* ── CARDS & GROUP BOXES ──────────────────────────────────── */
QGroupBox {
    background-color: rgba(255, 255, 255, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.9);
    border-radius: 12px;
    margin-top: 22px;
    padding-top: 16px;
    padding-bottom: 8px;
    padding-left: 4px;
    padding-right: 4px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 4px 16px;
    background: @COLOR_PRIMARY@;
    color: #ffffff;
    border-radius: 8px;
    font-weight: 700;
    font-size: 12px;
}

/* ── PROGRESS BAR (generation indicator) ─────────────────── */
QProgressBar {
    border: none;
    border-radius: 2px;
    background-color: rgba(194, 198, 214, 0.4);
    max-height: 4px;
    min-height: 4px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: @COLOR_PRIMARY@;
    border-radius: 2px;
}

/* ── TABLE ────────────────────────────────────────────────── */
QTableWidget {
    background-color: rgba(255, 255, 255, 0.82);
    alternate-background-color: rgba(246, 250, 255, 0.85);
    gridline-color: rgba(194, 198, 214, 0.25);
    selection-background-color: @COLOR_HOVER@;
    border: 1px solid rgba(194, 198, 214, 0.3);
    border-radius: 12px;
    color: #1a1c1e;
}

QTableWidget::item {
    padding: 6px 12px;
    border: none;
    color: #1a1c1e;
}

QTableWidget::item:hover {
    background-color: rgba(246, 250, 255, 0.9);
}

QTableWidget::item:selected {
    background-color: @COLOR_HOVER@;
    color: @COLOR_PRIMARY@;
}

QHeaderView {
    background-color: transparent;
}

QHeaderView::section {
    background-color: @COLOR_PRIMARY@;
    color: #ffffff;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.6px;
    border: none;
    border-right: 1px solid rgba(255, 255, 255, 0.15);
    padding: 10px 12px;
    min-height: 36px;
}

QHeaderView::section:last-child {
    border-right: none;
}

QHeaderView::section:hover {
    background-color: @COLOR_SECONDARY@;
}

/* ── DATE EDIT ────────────────────────────────────────────── */
QDateEdit {
    background-color: #FFFFFF;
    border: 1px solid rgba(194, 198, 214, 0.6);
    border-radius: 8px;
    color: #1a1c1e;
    padding: 3px 8px;
}

/* ── BUTTONS ──────────────────────────────────────────────── */
QPushButton {
    background-color: rgba(222, 227, 235, 0.85);
    color: #42474e;
    border: 1px solid rgba(194, 198, 214, 0.5);
    border-radius: 8px;
    padding: 6px 14px;
    font-size: 11px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: @COLOR_HOVER@;
    border-color: @COLOR_PRIMARY@;
    color: @COLOR_PRIMARY@;
}

QPushButton:pressed {
    background-color: rgba(0, 90, 194, 0.12);
    border-color: @COLOR_SECONDARY@;
    color: @COLOR_SECONDARY@;
}

QPushButton:focus {
    border-color: @COLOR_PRIMARY@;
    outline: none;
}

QPushButton:disabled {
    color: rgba(66, 71, 78, 0.4);
    background-color: rgba(240, 244, 249, 0.8);
    border: 1px solid rgba(194, 198, 214, 0.3);
}

/* Generate CTA — solid blue pill */
QPushButton#generateBtn {
    background: #005ac2;
    border: none;
    border-radius: 10px;
    color: #ffffff;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.3px;
    padding: 10px 0;
}

QPushButton#generateBtn:hover {
    background-color: @COLOR_SECONDARY@;
}

QPushButton#generateBtn:pressed {
    background-color: #003380;
}

QPushButton#generateBtn:disabled {
    background-color: rgba(0, 90, 194, 0.3);
    color: rgba(255, 255, 255, 0.6);
    border: none;
}

/* ── TAB WIDGET (pane only — bar is hidden, header uses custom buttons) */
QTabWidget {
    background: transparent;
}

QTabWidget::pane {
    border: none;
    background: transparent;
    margin-top: 0;
}

/* ── LIST WIDGET ──────────────────────────────────────────── */
QListWidget {
    background-color: rgba(255, 255, 255, 0.82);
    border: 1px solid rgba(194, 198, 214, 0.4);
    border-radius: 8px;
    outline: none;
    color: #1a1c1e;
}

QListWidget::item {
    padding: 6px 10px;
    border-radius: 6px;
    margin: 1px 3px;
    color: #1a1c1e;
}

QListWidget::item:hover {
    background-color: rgba(0, 90, 194, 0.05);
}

QListWidget::item:selected {
    background-color: @COLOR_HOVER@;
    color: @COLOR_PRIMARY@;
}

/* ── RADIO BUTTONS ────────────────────────────────────────── */
QRadioButton {
    color: #1a1c1e;
    font-size: 13px;
    font-weight: 500;
    spacing: 8px;
}

QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border-radius: 8px;
    border: 2px solid rgba(194, 198, 214, 0.9);
    background: #FFFFFF;
}

QRadioButton::indicator:hover {
    border-color: @COLOR_PRIMARY@;
}

QRadioButton::indicator:checked {
    border: 5px solid @COLOR_PRIMARY@;
    background: #FFFFFF;
    border-radius: 8px;
}

/* ── SCROLLBARS ───────────────────────────────────────────── */
QScrollBar:vertical {
    width: 7px;
    background: transparent;
    border-radius: 3px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: rgba(194, 198, 214, 0.8);
    min-height: 24px;
    border-radius: 3px;
}

QScrollBar::handle:vertical:hover {
    background: rgba(114, 119, 132, 0.8);
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }

QScrollBar:horizontal {
    height: 7px;
    background: transparent;
    border-radius: 3px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: rgba(194, 198, 214, 0.8);
    min-width: 24px;
    border-radius: 3px;
}

QScrollBar::handle:horizontal:hover {
    background: rgba(114, 119, 132, 0.8);
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

/* ── CALENDAR POPUP (QDateEdit dropdown) ─────────────────── */
QCalendarWidget {
    background-color: #FFFFFF;
}

QCalendarWidget QAbstractItemView {
    background-color: #FFFFFF;
    color: #1a1c1e;
    selection-background-color: @COLOR_PRIMARY@;
    selection-color: #FFFFFF;
    outline: none;
    gridline-color: rgba(194, 198, 214, 0.3);
}

QCalendarWidget QAbstractItemView:enabled {
    color: #1a1c1e;
    background-color: #FFFFFF;
}

QCalendarWidget QAbstractItemView:disabled {
    color: rgba(194, 198, 214, 0.9);
}

QCalendarWidget QWidget#qt_calendar_navigationbar {
    background-color: rgba(246, 250, 255, 0.95);
    border-bottom: 1px solid rgba(194, 198, 214, 0.3);
    padding: 4px 8px;
    min-height: 36px;
}

QCalendarWidget QToolButton {
    color: #42474e;
    background-color: transparent;
    border: none;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 12px;
    font-weight: 600;
    min-width: 24px;
}

QCalendarWidget QToolButton:hover {
    background-color: @COLOR_HOVER@;
    color: @COLOR_PRIMARY@;
}

QCalendarWidget QToolButton:pressed {
    background-color: rgba(0, 90, 194, 0.12);
    color: @COLOR_SECONDARY@;
}

QCalendarWidget QSpinBox {
    color: #42474e;
    background-color: #FFFFFF;
    border: 1px solid rgba(194, 198, 214, 0.5);
    border-radius: 4px;
    padding: 2px 6px;
    selection-background-color: @COLOR_PRIMARY@;
    selection-color: #FFFFFF;
}

QCalendarWidget QMenu {
    background-color: #FFFFFF;
    color: #1a1c1e;
    border: 1px solid rgba(194, 198, 214, 0.3);
    border-radius: 6px;
}

QCalendarWidget QMenu::item:selected {
    background-color: @COLOR_HOVER@;
    color: @COLOR_PRIMARY@;
}

/* ── SPLITTER ─────────────────────────────────────────────── */
QSplitter {
    background: transparent;
}

QSplitter::handle {
    background: rgba(194, 198, 214, 0.4);
}

QSplitter::handle:hover {
    background: @COLOR_PRIMARY@;
}

/* ── MISC ─────────────────────────────────────────────────── */
QLabel, QScrollArea, QScrollArea > QWidget > QWidget {
    background: transparent;
}

QScrollBar {
    background: transparent;
}
